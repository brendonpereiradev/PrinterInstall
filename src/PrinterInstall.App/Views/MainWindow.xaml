<Window x:Class="PrinterInstall.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:PrinterInstall.App.Converters"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:PrinterInstall.App.ViewModels;assembly=PrinterInstall.App"
        mc:Ignorable="d"
        Title="{DynamicResource Main_WindowTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="800" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppCanvasBackgroundBrush}">
    <Window.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:TargetMachineStateToBrushConverter x:Key="StateBrushConverter"/>
        <conv:TargetMachineStateToIconConverter x:Key="StateIconConverter"/>

        <!-- Pincéis para neutralizar seleção azul padrão do WPF -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource AppTextPrimaryBrush}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource AppTextPrimaryBrush}"/>

        <!-- Estilos para a tabela moderna de status -->
        <Style x:Key="StatusColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8,12,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableDividerBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppTableDividerBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppTableRowHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppTableRowSelectedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusTextElementStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ModernStatusDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppTableDividerBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{x:Null}"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource StatusColumnHeaderStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource StatusCellStyle}"/>
            <Setter Property="RowStyle" Value="{StaticResource StatusRowStyle}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <Border DockPanel.Dock="Top" Height="3" Background="{DynamicResource AppHeaderAccentBrush}"/>
            <ui:Button DockPanel.Dock="Right"
                       Margin="0,0,16,0"
                       Padding="8"
                       Appearance="Transparent"
                       VerticalAlignment="Center"
                       Command="{Binding ToggleThemeCommand}">
                <ui:Button.ToolTip>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{DynamicResource Main_ThemeToggle_DarkToolTip}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource Main_ThemeToggle_LightToolTip}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ui:Button.ToolTip>
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="{DynamicResource AppTextPrimaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE708;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                    <Setter Property="Text" Value="&#xE706;"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </ui:Button>
            <StackPanel Margin="16,12,16,8">
                <TextBlock Text="{DynamicResource Main_WindowTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource Main_PageSubtitle}" FontSize="12"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="220" MinHeight="160"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="200"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource AppSurfaceCardBrush}"
                            BorderBrush="{DynamicResource AppSurfaceCardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <DockPanel LastChildFill="True">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Main_ComputersLabel}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                                <ui:Button Grid.Column="1"
                                           Content="{DynamicResource Main_AddThisComputer}"
                                           Command="{Binding AddThisComputerCommand}"
                                           Appearance="Secondary"
                                           Padding="8,4"/>
                            </Grid>
                            <TextBox Text="{Binding ComputersText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Background="{DynamicResource AppInputBackgroundBrush}"
                                     BorderBrush="{DynamicResource AppInputBorderBrush}"
                                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                                     Padding="6"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource AppSurfaceCardBrush}"
                            BorderBrush="{DynamicResource AppSurfaceCardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <TextBlock Text="{DynamicResource Main_StatusGroupHeader}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       Margin="2,0,0,6"
                                       VerticalAlignment="Top"/>
                            <DataGrid Style="{StaticResource ModernStatusDataGridStyle}"
                                      ItemsSource="{Binding Targets}"
                                      Margin="0,26,0,0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      Visibility="{Binding ShowStatusEmptyHint, Converter={StaticResource InverseBoolToVis}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Main_ColumnComputer}" Binding="{Binding ComputerNameDisplay}" Width="*" ElementStyle="{StaticResource StatusTextElementStyle}"/>
                                    <DataGridTextColumn Header="{DynamicResource Main_ColumnQueue}" Binding="{Binding PrinterQueueName}" Width="130" ElementStyle="{StaticResource StatusTextElementStyle}"/>
                                    <DataGridTemplateColumn Header="{DynamicResource Main_ColumnState}" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,3"
                                                        CornerRadius="10"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding State, Converter={StaticResource StateBrushConverter}}"
                                                        BorderBrush="{Binding State, Converter={StaticResource StateBrushConverter}, ConverterParameter=Border}"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="12"
                                                                   Margin="0,0,6,0"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding State, Converter={StaticResource StateIconConverter}}"
                                                                   Foreground="{Binding State, Converter={StaticResource StateBrushConverter}, ConverterParameter=Foreground}"/>
                                                        <TextBlock Text="{Binding StateDisplay}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{Binding State, Converter={StaticResource StateBrushConverter}, ConverterParameter=Foreground}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{DynamicResource Main_ColumnMessage}" Binding="{Binding Message}" Width="2*" ElementStyle="{StaticResource StatusTextElementStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{DynamicResource Main_StatusEmptyHint}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="16"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       Visibility="{Binding ShowStatusEmptyHint, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Main_PrintersGroupHeader}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource AppTextPrimaryBrush}" Margin="0,0,0,6"/>
                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8">
                        <ItemsControl ItemsSource="{Binding PrinterRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource AppSurfaceCardBrush}"
                                            BorderBrush="{DynamicResource AppSurfaceCardBorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,4">
                                                <TextBlock Text="{DynamicResource Main_BrandLabel}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ComboBox ItemsSource="{Binding Source={x:Static vm:PrinterFormRowViewModel.BrandChoices}}" SelectedItem="{Binding Brand}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,4">
                                                <TextBlock Text="{DynamicResource Main_PrinterHostLabel}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding PrinterHostAddress, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4">
                                                <TextBlock Text="{DynamicResource Main_DisplayNameLabel}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,0"
                                                        Visibility="{Binding IsGainschaBrand, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{DynamicResource Main_GainschaLabelPresetLabel}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="0,0,0,2"/>
                                                <ComboBox ItemsSource="{Binding Source={x:Static vm:PrinterFormRowViewModel.GainschaLabelPresetChoices}}"
                                                          SelectedItem="{Binding GainschaLabelPreset}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:Button Content="{DynamicResource Main_AddPrinterRow}" Command="{Binding AddPrinterRowCommand}" Appearance="Secondary" Margin="0,0,8,0"/>
                        <ui:Button Content="{DynamicResource Main_RemovePrinterRow}" Command="{Binding RemovePrinterRowCommand}" CommandParameter="{x:Null}"
                                   Visibility="{Binding CanRemovePrinterRow, Converter={StaticResource BoolToVis}}" Appearance="Secondary"/>
                    </StackPanel>
                    <CheckBox Content="{DynamicResource Main_PrintTestPageLabel}" IsChecked="{Binding PrintTestPage}"
                              Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ui:Button Content="{DynamicResource Main_DeployButton}" Command="{Binding DeployCommand}"
                                   Appearance="Primary"/>
                        <ui:Button Content="{DynamicResource Main_CancelDeployButton}" Command="{Binding CancelDeployCommand}"
                                   Appearance="Secondary" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ui:Button Content="{DynamicResource Main_RemovePrintersButton}" Command="{Binding OpenRemovalWizardCommand}"
                               Appearance="Secondary" Margin="0,0,0,0"/>
                    <ui:Button Content="{DynamicResource Main_TestPrinterButton}"
                               Command="{Binding OpenPrinterNetworkTestCommand}"
                               Appearance="Secondary" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource AppSurfaceCardBrush}"
                    BorderBrush="{DynamicResource AppSurfaceCardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Main_LogGroupHeader}" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center"/>
                        <ui:Button Grid.Column="1" Content="{DynamicResource Main_ExportLogButton}"
                                   Command="{Binding ExportLogCommand}"
                                   IsEnabled="{Binding CanExportLog}"
                                   Appearance="Secondary" Padding="12,4"/>
                    </Grid>
                    <TextBox Text="{Binding LogText}" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                             Background="{DynamicResource AppConsoleBackgroundBrush}"
                             BorderBrush="{DynamicResource AppConsoleBorderBrush}"
                             Foreground="{DynamicResource AppConsoleForegroundBrush}"
                             Padding="8" BorderThickness="1"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
