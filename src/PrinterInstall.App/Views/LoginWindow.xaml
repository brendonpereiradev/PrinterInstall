<Window x:Class="PrinterInstall.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:conv="clr-namespace:PrinterInstall.App.Converters"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        Title="{DynamicResource Login_WindowTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="450" Width="400"
        MinHeight="450" MaxHeight="450" MinWidth="400" MaxWidth="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppCanvasBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Conversores de Visibilidade e Lógica -->
        <conv:StringNullOrWhiteSpaceToVisibilityConverter x:Key="StringNullOrEmptyToVis"/>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter"/>

        <!-- Estilo do Container de Campo de Entrada com Borda de Foco Interativa -->
        <Style x:Key="LoginFieldContainerStyle" TargetType="Border">
            <Setter Property="Height" Value="42"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppInputBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AppBrandAccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo Interno de TextBox -->
        <Style x:Key="LoginInnerTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppBrandAccentBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo Interno de PasswordBox -->
        <Style x:Key="LoginInnerPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppBrandAccentBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo do Botão Primário com Cor de Acento e Alto Contraste -->
        <Style x:Key="LoginPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AppBrandAccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AppAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo de Botão Utilitário Transparente (Ghost) -->
        <Style x:Key="LoginGhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GhostBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GhostBorder" Property="Background" Value="{DynamicResource AppTableHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GhostBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Bar: Ações de Tema e Configurações de Rede/Domínio -->
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Margin="0,12,16,0">
            <!-- Botão de alternância de modo escuro/claro -->
            <Button
                Style="{StaticResource LoginGhostButtonStyle}"
                Margin="0,0,4,0"
                Command="{Binding ToggleThemeCommand}">
                <Button.ToolTip>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{DynamicResource Login_ThemeToggle_DarkToolTip}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource Login_ThemeToggle_LightToolTip}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button.ToolTip>
                <TextBlock
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Foreground="{DynamicResource AppTextSecondaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE708;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                    <Setter Property="Text" Value="&#xE706;"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>

            <!-- Botão de configurações de domínio e rede -->
            <Button
                Style="{StaticResource LoginGhostButtonStyle}"
                ToolTip="{DynamicResource Login_SettingsToolTip}"
                Click="Settings_OnClick">
                <TextBlock
                    FontFamily="Segoe MDL2 Assets"
                    Text="&#xE713;"
                    FontSize="16"
                    Foreground="{DynamicResource AppTextSecondaryBrush}"/>
            </Button>
        </StackPanel>

        <!-- Formulário Central Direto na Superfície da Janela (Sem Caixa Aninhada) -->
        <StackPanel
            Grid.Row="1"
            VerticalAlignment="Center"
            Margin="36,0,36,16">

            <!-- Cabeçalho com Título -->
            <TextBlock
                Text="{DynamicResource Login_Header}"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{DynamicResource AppTextPrimaryBrush}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                Margin="0,0,0,24"/>

            <!-- Campo Usuário -->
            <TextBlock
                Text="{DynamicResource Login_UserLabel}"
                Foreground="{DynamicResource AppTextSecondaryBrush}"
                FontSize="13"
                FontWeight="Medium"
                Margin="0,0,0,6"/>
            <Border Style="{StaticResource LoginFieldContainerStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontFamily="Segoe MDL2 Assets"
                        Text="&#xE77B;"
                        FontSize="16"
                        Foreground="{DynamicResource AppTextSecondaryBrush}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock
                            Text="{DynamicResource Login_UserPlaceholder}"
                            Foreground="{DynamicResource AppTextMutedBrush}"
                            FontSize="13"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding UserName, Converter={StaticResource StringNullOrEmptyToVis}}"/>
                        <TextBox
                            x:Name="UserNameTextBox"
                            Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource LoginInnerTextBoxStyle}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Campo Senha -->
            <TextBlock
                Text="{DynamicResource Login_PasswordLabel}"
                Foreground="{DynamicResource AppTextSecondaryBrush}"
                FontSize="13"
                FontWeight="Medium"
                Margin="0,14,0,6"/>
            <Border Style="{StaticResource LoginFieldContainerStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontFamily="Segoe MDL2 Assets"
                        Text="&#xE72E;"
                        FontSize="16"
                        Foreground="{DynamicResource AppTextSecondaryBrush}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                        <TextBlock
                            Text="{DynamicResource Login_PasswordPlaceholder}"
                            Foreground="{DynamicResource AppTextMutedBrush}"
                            FontSize="13"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding Password, Converter={StaticResource StringNullOrEmptyToVis}}"/>
                        <!-- Modo Senha Oculta -->
                        <PasswordBox
                            x:Name="PasswordBox"
                            Style="{StaticResource LoginInnerPasswordBoxStyle}"
                            PasswordChanged="PasswordBox_OnPasswordChanged"
                            Visibility="{Binding IsPasswordRevealed, Converter={StaticResource InverseBoolToVis}}"/>
                        <!-- Modo Senha Visível -->
                        <TextBox
                            x:Name="RevealedPasswordTextBox"
                            Style="{StaticResource LoginInnerTextBoxStyle}"
                            TextChanged="RevealedPasswordTextBox_OnTextChanged"
                            Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <!-- Botão de Alternância de Visibilidade da Senha -->
                    <Button
                        Grid.Column="2"
                        Style="{StaticResource LoginGhostButtonStyle}"
                        Padding="6"
                        Focusable="False"
                        Command="{Binding TogglePasswordVisibilityCommand}">
                        <Button.ToolTip>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource Login_ShowPasswordToolTip}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPasswordRevealed}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource Login_HidePasswordToolTip}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.ToolTip>
                        <TextBlock
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="15"
                            Foreground="{DynamicResource AppTextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE7B3;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPasswordRevealed}" Value="True">
                                            <Setter Property="Text" Value="&#xED1A;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>
            </Border>

            <!-- CheckBox Lembrar-me -->
            <CheckBox
                Content="{DynamicResource Login_RememberMeLabel}"
                IsChecked="{Binding RememberMe}"
                Margin="0,14,0,0"
                FontSize="13"
                Foreground="{DynamicResource AppTextSecondaryBrush}"/>

            <!-- Banner Semântico de Erro / Alerta -->
            <Border
                Background="{DynamicResource AppBadgeDangerBackgroundBrush}"
                BorderBrush="{DynamicResource AppBadgeDangerBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,12,0,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullOrEmptyToVis}, ConverterParameter=Invert}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontFamily="Segoe MDL2 Assets"
                        Text="&#xE783;"
                        FontSize="15"
                        Foreground="{DynamicResource AppBadgeDangerForegroundBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"/>
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding ErrorMessage}"
                        Foreground="{DynamicResource AppBadgeDangerForegroundBrush}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Botão Principal de Login com Indicador de Progresso -->
            <Button
                Style="{StaticResource LoginPrimaryButtonStyle}"
                HorizontalAlignment="Stretch"
                Margin="0,18,0,0"
                IsDefault="True"
                IsEnabled="{Binding IsAuthenticating, Converter={StaticResource InverseBoolConverter}}"
                Click="SignIn_OnClick">
                <Grid>
                    <!-- Conteúdo em Estado Normal -->
                    <TextBlock
                        Text="{DynamicResource Login_SignInButton}"
                        FontWeight="SemiBold"
                        FontSize="14"
                        Foreground="#FFFFFFFF"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsAuthenticating, Converter={StaticResource InverseBoolToVis}}"/>

                    <!-- Conteúdo em Estado Autenticando -->
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsAuthenticating, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing
                            Width="16"
                            Height="16"
                            IsIndeterminate="True"
                            Foreground="#FFFFFFFF"
                            Margin="0,0,8,0"/>
                        <TextBlock
                            Text="{DynamicResource Login_SigningInButton}"
                            FontWeight="SemiBold"
                            FontSize="14"
                            Foreground="#FFFFFFFF"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Button>
        </StackPanel>
    </Grid>
</Window>
