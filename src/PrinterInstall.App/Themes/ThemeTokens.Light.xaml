<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Tema claro -->

  <!-- Janela (usada quando o Mica não está ativo, ex.: diálogos) -->
  <SolidColorBrush x:Key="AppCanvasBackgroundBrush" Color="#FFF4F4F6"/>

  <!-- Cards -->
  <SolidColorBrush x:Key="AppSurfaceCardBrush" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="AppSurfaceCardBorderBrush" Color="#FFE4E4E7"/>

  <!-- Campos de entrada -->
  <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="AppInputBorderBrush" Color="#FFD4D4D8"/>

  <!-- Log -->
  <SolidColorBrush x:Key="AppConsoleBackgroundBrush" Color="#FFF8F8FA"/>
  <SolidColorBrush x:Key="AppConsoleBorderBrush" Color="#FFE4E4E7"/>
  <SolidColorBrush x:Key="AppConsoleForegroundBrush" Color="#FF18181B"/>

  <!-- Texto -->
  <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FF18181B"/>
  <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#FF71717A"/>
  <SolidColorBrush x:Key="AppTextMutedBrush" Color="#FFA1A1AA"/>

  <!-- Acento -->
  <SolidColorBrush x:Key="AppBrandAccentBrush" Color="#FF2563EB"/>
  <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#FF1D4ED8"/>

  <!-- Tabelas -->
  <SolidColorBrush x:Key="AppTableHoverBrush" Color="#FFF4F4F6"/>
  <SolidColorBrush x:Key="AppTableRowSelectedBrush" Color="#FFE4E4E7"/>
  <SolidColorBrush x:Key="AppTableDividerBrush" Color="#FFE4E4E7"/>

  <!-- Badges semânticos -->
  <SolidColorBrush x:Key="AppBadgeSuccessBackgroundBrush" Color="#FFE7F6EC"/>
  <SolidColorBrush x:Key="AppBadgeSuccessBorderBrush" Color="#FF87C79B"/>
  <SolidColorBrush x:Key="AppBadgeSuccessForegroundBrush" Color="#FF1F6B35"/>

  <SolidColorBrush x:Key="AppBadgeDangerBackgroundBrush" Color="#FFFCE8E8"/>
  <SolidColorBrush x:Key="AppBadgeDangerBorderBrush" Color="#FFE59A9A"/>
  <SolidColorBrush x:Key="AppBadgeDangerForegroundBrush" Color="#FF8C1D1D"/>

  <SolidColorBrush x:Key="AppBadgeInfoBackgroundBrush" Color="#FFE5F2FF"/>
  <SolidColorBrush x:Key="AppBadgeInfoBorderBrush" Color="#FF7AB6F0"/>
  <SolidColorBrush x:Key="AppBadgeInfoForegroundBrush" Color="#FF0C4A8A"/>

  <SolidColorBrush x:Key="AppBadgeWarningBackgroundBrush" Color="#FFFFF4E5"/>
  <SolidColorBrush x:Key="AppBadgeWarningBorderBrush" Color="#FFE2BD7A"/>
  <SolidColorBrush x:Key="AppBadgeWarningForegroundBrush" Color="#FF8A5A00"/>

  <SolidColorBrush x:Key="AppBadgeNeutralBackgroundBrush" Color="#FFF1F5F9"/>
  <SolidColorBrush x:Key="AppBadgeNeutralBorderBrush" Color="#FFCBD5E1"/>
  <SolidColorBrush x:Key="AppBadgeNeutralForegroundBrush" Color="#FF475569"/>
</ResourceDictionary>
